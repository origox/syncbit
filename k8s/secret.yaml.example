apiVersion: v1
kind: Secret
metadata:
  name: syncbit-secrets
  namespace: default
type: Opaque
stringData:
  # Google Health API OAuth2 credentials (HEALTH_PROVIDER=google, the default)
  # Get these from https://console.cloud.google.com/auth/clients
  GOOGLE_CLIENT_ID: "your_client_id.apps.googleusercontent.com"
  GOOGLE_CLIENT_SECRET: "your_client_secret_here"

  # Legacy Fitbit Web API credentials (only for HEALTH_PROVIDER=fitbit;
  # the Fitbit Web API was shut down on 2026-11-02)
  # FITBIT_CLIENT_ID: "your_client_id_here"
  # FITBIT_CLIENT_SECRET: "your_client_secret_here"
  
  # Victoria Metrics credentials
  VICTORIA_USER: "your_username_here"
  VICTORIA_PASSWORD: "your_password_here"
